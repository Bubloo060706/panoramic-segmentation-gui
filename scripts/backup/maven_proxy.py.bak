import http.server
import socketserver
import http.client
import ssl
import socket
import os
import sys

PORT = 8888
TARGET_IP = "104.18.19.12"
TARGET_HOST = "repo1.maven.org"

class MavenProxyHandler(http.server.BaseHTTPRequestHandler):
    def do_HEAD(self):
        self._forward_request("HEAD")

    def do_GET(self):
        self._forward_request("GET")

    def _forward_request(self, method):
        try:
            ctx = ssl.create_default_context()
            s = socket.create_connection((TARGET_IP, 443), timeout=15)
            ss = ctx.wrap_socket(s, server_hostname=TARGET_HOST)
            conn = http.client.HTTPSConnection(TARGET_HOST, timeout=15)
            conn.sock = ss

            req_headers = {"Host": TARGET_HOST, "User-Agent": "Apache-Maven/3.9.9"}
            for k, v in self.headers.items():
                if k.lower() not in ("host", "user-agent"):
                    req_headers[k] = v

            conn.request(method, self.path, headers=req_headers)
            resp = conn.getresponse()

            self.send_response(resp.status)
            for k, v in resp.getheaders():
                if k.lower() not in ("transfer-encoding", "connection"):
                    self.send_header(k, v)
            self.end_headers()

            if method != "HEAD":
                while True:
                    chunk = resp.read(65536)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
            conn.close()
        except Exception as e:
            self.send_error(502, f"Proxy error: {e}")

    def log_message(self, format, *args):
        # Keep logs minimal
        pass

if __name__ == "__main__":
    server = socketserver.TCPServer(("127.0.0.1", PORT), MavenProxyHandler)
    print(f"Maven proxy running on http://127.0.0.1:{PORT}/")
    sys.stdout.flush()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
